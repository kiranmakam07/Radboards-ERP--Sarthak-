# Copy to .env (never commit .env).

# --- API ---------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Leave DATABASE_URL unset for zero-setup local dev: the API uses an embedded
# PostgreSQL (PGlite) stored in apps/api/.data.
# For staging/production point it at real PostgreSQL 16+:
# DATABASE_URL=postgres://radcore:change-me@localhost:5432/radcore

# Where the web app is served from (comma-separated if more than one).
# State-changing API requests from any other browser origin are refused.
WEB_ORIGIN=http://localhost:3000

SESSION_TTL_DAYS=14
# Set to true behind HTTPS (defaults to true when NODE_ENV=production).
# COOKIE_SECURE=true

# First admin, created only when the users table is empty.
# If SEED_ADMIN_PASSWORD is not set, a random password is generated and printed once.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PHONE=+919999999999
# SEED_ADMIN_PASSWORD=

# --- Web ---------------------------------------------------------------------
# The Next.js app proxies /api/* to this address.
API_URL=http://localhost:4000
