# Copy to .env.production on the server and fill in. Never commit the filled-in file.

# The address people will open, without https://. Its DNS must point at this server.
DOMAIN=erp.example.com

# Database password. Use letters and digits only (it goes inside a connection URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# First admin, created once when the users table is empty. Sign in and change the password.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# A REVIEW COPY (for the founder and team to try before real use): set SEED_DEMO_DATA=true and choose
# DEMO_PASSWORD (at least 10 characters). On first start the empty database is filled with sample data
# and one sign-in per role: phone 9000000000 to 9000000008, all with DEMO_PASSWORD. Leave both as they
# are for the real system. See "A review copy" in the README for moving from one to the other.
SEED_DEMO_DATA=false
DEMO_PASSWORD=

# How many days of daily database backups to keep on the server.
BACKUP_KEEP_DAYS=30

# Lead capture from Meta: Facebook / Instagram lead ads and WhatsApp Business. Leave blank until
# the Meta app exists; while blank, those webhooks refuse everything. See "Connecting lead sources"
# in the README.
#   META_APP_SECRET         from the Meta app's Settings > Basic. Proves a webhook really is from Meta.
#   META_VERIFY_TOKEN       any long random string you make up (openssl rand -hex 16); typed once into
#                           Meta when subscribing the webhook.
#   META_PAGE_ACCESS_TOKEN  a long-lived Page token with leads_retrieval; lets RadCore read lead forms.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Optional: an "are you a person" check on the public enquiry form, to keep bots from filling the
# lead list. Create a free Turnstile widget for your domain at Cloudflare and paste its two keys.
# Leave blank to run without it (the form still has a hidden trap field and a rate limit).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
