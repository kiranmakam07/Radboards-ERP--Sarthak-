# Copy to .env.production on the server and fill in. Never commit the filled-in file.

# The address people will open, without https://. Its DNS must point at this server.
DOMAIN=erp.example.com

# Database password. Use letters and digits only (it goes inside a connection URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# The password of the login the API itself uses (radcore_app), which can read and write rows but not change
# or drop tables; the owner above is used only for the migrations at start. A different one: openssl rand -hex 24
APP_DB_PASSWORD=

# First admin, created once when the users table is empty. Sign in and change the password.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# A REVIEW COPY (for the founder and team to try before real use): set SEED_DEMO_DATA=true and choose
# DEMO_PASSWORD (at least 10 characters). On first start the empty database is filled with sample data
# and one sign-in per role: phone 9000000000 to 9000000008, all with DEMO_PASSWORD. Leave both as they
# are for the real system. See "A review copy" in the README for moving from one to the other.
SEED_DEMO_DATA=false
DEMO_PASSWORD=

# How many days of daily database backups to keep on the server.
BACKUP_KEEP_DAYS=30
# Off-site backups (recommended): an S3 bucket in Mumbai (ap-south-1) and an access key for a user that may
# only put and list files in it. Blank = backups stay on this server only. Each daily dump goes to db/, the
# attached files to uploads/; set how long they are kept with a lifecycle rule on the bucket.
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# Lead capture from Meta: Facebook / Instagram lead ads and WhatsApp Business. Leave blank until
# the Meta app exists; while blank, those webhooks refuse everything. See "Connecting lead sources"
# in the README.
#   META_APP_SECRET         from the Meta app's Settings > Basic. Proves a webhook really is from Meta.
#   META_VERIFY_TOKEN       any long random string you make up (openssl rand -hex 16); typed once into
#                           Meta when subscribing the webhook.
#   META_PAGE_ACCESS_TOKEN  a long-lived Page token with leads_retrieval; lets RadCore read lead forms.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Sending WhatsApp messages from inside the app (optional). The phone number id from Meta's
# WhatsApp > API setup, and a permanent system-user token with whatsapp_business_messaging.
# Blank = replies go out from each person's own WhatsApp, as before.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# A long random text that locks the secrets kept in the database (today: the passwords that open
# bank statements). Make one with: openssl rand -hex 32. Keep it: if it changes, the saved
# passwords can no longer be read and have to be entered again. Blank = they cannot be saved.
APP_SECRET=

# Bank statements by email (optional). A mailbox of its own that the bank's statement mails are
# forwarded to, read over IMAP with an app password. Blank = statements are chosen by hand on
# the Bank reconciliation screen. See "Bank statements by email" in the README.
#   BANK_MAIL_HOST         imap.gmail.com for Gmail, imap.zoho.in for Zoho Mail (India)
#   BANK_MAIL_USER         the mailbox's address
#   BANK_MAIL_PASSWORD     an app password made for this, not the mailbox's own password
#   BANK_MAIL_CRON_SECRET  any long random text; lets a scheduler ask for the mailbox to be read
BANK_MAIL_HOST=
BANK_MAIL_PORT=993
BANK_MAIL_USER=
BANK_MAIL_PASSWORD=
BANK_MAIL_FOLDER=INBOX
BANK_MAIL_CRON_SECRET=

# Backups encrypted (strongly advised): a long random key every backup is encrypted with, here and off-site.
# Make one with: openssl rand -hex 32. Keep a copy OFF the server (a password manager): a backup cannot be
# restored without it, and a key kept only on the server is lost with the server.
BACKUP_ENCRYPTION_KEY=

# Alerts (strongly advised): where RadCore reports a failed request, a failed background job, a failed
# backup or restore drill. An incoming-webhook address from Slack, Google Chat or Discord, or an ntfy.sh
# topic (https://ntfy.sh/<a long random name>) whose app is on the owner's phone. Blank = problems are
# only listed on Admin > System health. Admin > System health has a button to send a test alert.
ALERT_WEBHOOK_URL=

# Orders from the Shopify store (optional). The signing key Shopify shows under
# Settings > Notifications > Webhooks. Blank = not connected. See "Online orders" in the README.
SHOPIFY_WEBHOOK_SECRET=

# Optional: an "are you a person" check on the public enquiry form, to keep bots from filling the
# lead list. Create a free Turnstile widget for your domain at Cloudflare and paste its two keys.
# Leave blank to run without it (the form still has a hidden trap field and a rate limit).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
